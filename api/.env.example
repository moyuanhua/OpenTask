# Application
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/opentask

# Redis
REDIS_URL=redis://localhost:6379

# Optional individual DB vars (alternative to DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=opentask
DB_SYNCHRONIZE=true
DB_LOGGING=false
